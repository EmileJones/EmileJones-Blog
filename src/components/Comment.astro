<div class="card-base px-6 md:px-9 py-6 mb-4">
  <!-- Fuwari 风格竖条标题 -->
  <div class="font-bold transition text-lg text-black/90 dark:text-white/90 relative ml-4 mb-4
      before:w-1 before:h-4 before:rounded-md before:bg-[var(--primary)]
      before:absolute before:left-[-1rem] before:top-[0.35rem]">
    评论
  </div>

  <!-- Giscus 容器 -->
  <div id="giscus-container"></div>
</div>

<script>
  function getGiscusTheme() {
    return document.documentElement.classList.contains('dark')
      ? 'noborder_dark'
      : 'noborder_light';
  }

  function loadGiscus() {
    const container = document.getElementById('giscus-container');
    if (!container) return;
    container.innerHTML = '';

    const script = document.createElement('script');
    script.src = 'https://giscus.app/client.js';
    script.setAttribute('data-repo', 'EmileJones/EmileJones-Blog');
    script.setAttribute('data-repo-id', 'R_kgDOT9UmvQ');
    script.setAttribute('data-category', 'Announcements');
    script.setAttribute('data-category-id', 'DIC_kwDOT9Umvc4DIe4K');
    script.setAttribute('data-mapping', 'pathname');
    script.setAttribute('data-strict', '1');
    script.setAttribute('data-reactions-enabled', '0'); // 关闭顶部表情，减少突兀留白
    script.setAttribute('data-emit-metadata', '0');
    script.setAttribute('data-input-position', 'top');
    script.setAttribute('data-theme', getGiscusTheme());
    script.setAttribute('data-lang', 'zh-CN');
    script.setAttribute('data-loading', 'lazy');
    script.setAttribute('crossorigin', 'anonymous');
    script.async = true;

    container.appendChild(script);
  }

  // 监听博客右上角明暗主题切换，实时同步给 Giscus iframe
  const observer = new MutationObserver(() => {
    const iframe = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
    if (iframe?.contentWindow) {
      iframe.contentWindow.postMessage(
        { giscus: { setConfig: { theme: getGiscusTheme() } } },
        'https://giscus.app'
      );
    }
  });
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

  // 初次加载与 Swup 页面跳转重载
  loadGiscus();
  document.addEventListener('swup:content:replace', loadGiscus);
</script>
